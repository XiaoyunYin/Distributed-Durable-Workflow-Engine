# Local configuration and credentials
.env
.env.*
!.env.example
/.aws/
/.secrets/
**/.terraform/
.tools/
*.tfplan
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Local agent instructions and project-management records.
# Kept on disk for continued work; excluded from the current publishable tree.
# Ignore rules do not remove these files from earlier commits.
/AGENTS.md
/CLAUDE.md
/PLAN.md
/REVIEW.md
/docs/
# Keep source, experiment artifacts, and runtime documentation outside docs/
# tracked when they are part of the public reproduction surface.

# Python
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
/.pytest-*/
.ruff_cache/
/.uv-cache*/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Go
/bin/
/runtime.exe
coverage.out
*.test
*.prof
/coverage*.out

# Local packaging output
/build/
/dist/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
.scratch/
*scratchpytest*/

# Experiment output is opt-in; manifests and documentation remain trackable.
experiments/**/raw/

* text=auto
*.go text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.md text eol=lf

# Copy to an ignored terraform.tfvars or pass variables through TF_VAR_*
# environment variables. Never commit real credentials or campaign plans.
aws_region              = "us-west-1"
availability_zones      = ["us-west-1a", "us-west-1c"]
ami_id                  = "ami-REPLACE_WITH_PINNED_UBUNTU_AMI"
instance_type           = "t3.micro"
dependency_instance_type = "t3.small"
# DUR-050 only: enable its separately budgeted generator/observer host and use
# the production-like role sizes from protocol-v2. Keep false for DUR-049.
# enable_dur050_load_generator = true
# instance_type = "c7i.large"
# dependency_instance_type = "m7i.large"
repo_ref                = "REPLACE_WITH_FULL_40_CHARACTER_COMMIT_SHA"
expires_at              = "2026-10-05T00:00:00Z"
admin_cidrs             = ["203.0.113.10/32"]

# Supply this only via TF_VAR_postgres_password or a local ignored tfvars file.
# postgres_password = "REPLACE_WITH_EPHEMERAL_ALPHANUMERIC_SECRET"
# DUR-050 only, and only with enable_dur050_load_generator=true. Never reuse the DB owner credential.
# dur050_observer_password = "REPLACE_WITH_DIFFERENT_EPHEMERAL_SECRET"

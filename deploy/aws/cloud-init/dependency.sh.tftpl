#!/usr/bin/env bash
set -euo pipefail

exec > >(tee /var/log/durable-dur049-bootstrap.log | logger -t durable-dur049-bootstrap -s 2>/dev/console) 2>&1
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y awscli ca-certificates curl git docker.io docker-compose-v2
systemctl enable --now docker

if ! swapon --show | grep -q .; then
  fallocate -l 1G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=1024
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

install -d -m 0750 /opt/durable-agent-execution-engine
if [ ! -d /opt/durable-agent-execution-engine/.git ]; then
  git init /opt/durable-agent-execution-engine
  git -C /opt/durable-agent-execution-engine remote add origin '${repo_url}'
  git -C /opt/durable-agent-execution-engine fetch --depth 1 origin '${repo_ref}'
  git -C /opt/durable-agent-execution-engine checkout --detach FETCH_HEAD
fi

umask 077
postgres_password="$$(aws ssm get-parameter --name '${postgres_secret_parameter}' --with-decryption --region '${aws_region}' --query 'Parameter.Value' --output text)"
cat > /opt/durable-agent-execution-engine/deploy/aws/.env <<EOF
POSTGRES_USER=${postgres_user}
POSTGRES_DB=${postgres_db}
POSTGRES_PASSWORD=$${postgres_password}
POSTGRES_IMAGE=${postgres_image}
KAFKA_IMAGE=${kafka_image}
DEPENDENCY_PRIVATE_IP=$$(hostname -I | awk '{print $1}')
EOF

cd /opt/durable-agent-execution-engine
docker compose --env-file deploy/aws/.env -f deploy/aws/dependency-compose.yaml up -d

for attempt in $$(seq 1 60); do
  if docker compose --env-file deploy/aws/.env -f deploy/aws/dependency-compose.yaml exec -T postgres pg_isready -U '${postgres_user}' -d '${postgres_db}' >/dev/null 2>&1; then
    break
  fi
  if [ "$${attempt}" -eq 60 ]; then
    echo 'PostgreSQL did not become ready' >&2
    exit 1
  fi
  sleep 3
done

for migration in migrations/*.up.sql; do
  echo "Applying $${migration}"
  docker compose --env-file deploy/aws/.env -f deploy/aws/dependency-compose.yaml exec -T postgres psql -v ON_ERROR_STOP=1 -U '${postgres_user}' -d '${postgres_db}' < "$${migration}"
done

touch /var/lib/durable-dur049-bootstrap-complete
